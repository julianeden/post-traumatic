{
  "manifest_version": 3,
  "name": "Traumasoft Mobile Schedule",
  "version": "0.1.0",
  "description": "Restyles the Traumasoft employee schedule calendar for phones: a day-by-day agenda for your own shifts and a one-day-at-a-time pager with open-shift filtering for the location views.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.traumasoft.com/main.php*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{74ed87be-f921-40fc-8ad6-3d04929af20d}",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
